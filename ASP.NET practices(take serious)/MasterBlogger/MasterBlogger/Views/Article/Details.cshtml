@model ArticleDTO
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="mb-3">
    <a href="/Articles" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title mb-0">@Model.Title</h3>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <small class="text-muted">Category: <strong>@Model.Category</strong></small>
            </div>
            <div class="col-md-6 text-md-end">
                <small class="text-muted">Author: <strong>@Model.JournalistFullName</strong></small>
            </div>
        </div>

        <div class="mb-3">
            <span class="badge bg-success">Published</span>
            <small class="text-muted ms-2">
                <i class="bi bi-calendar-check"></i> @Model.CreationDate.ToString("yyyy-MM-dd HH:mm")
            </small>
        </div>

        <hr />

        <div class="article-content">
            <p>@Model.Content</p>
        </div>

        <hr />

        <div class="row text-muted">
            <div class="col-md-6">
                <small>
                    <i class="bi bi-plus-circle"></i> @Model.CreationDate.ToString("yyyy-MM-dd HH:mm")
            <div class="col-md-6 text-md-end">
                <small><i class="bi bi-pencil-square"></i> Updated: Jan 01, 2024 10:30</small>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="btn-group">
            <a asp-action="Edit" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a asp-action="Delete" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete
            </a>
        </div>
    </div>
</div>