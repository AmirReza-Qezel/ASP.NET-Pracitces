@model UpdateArticleCommand
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<div class="mb-3">
    <a href="/Articles" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title mb-0"><i class="bi bi-pencil"></i> Edit Article</h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <!-- Hidden ID field -->
            <input type="hidden" asp-for="Id" />

            <!-- Validation summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Title</label>
                <input type="text" asp-for="Title" class="form-control" placeholder=@Model.Title value="Sample Title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label fw-bold">Content</label>
                <textarea asp-for="Content" class="form-control" rows="8"
                placeholder=@Model.Content></textarea>
                <span asp-validation-for="Content" id="Content-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ArticleCategoryId" class="form-label fw-bold">Category</label>
                <select asp-for="ArticleCategoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">Select a category...</option>
                </select>
                <span asp-validation-for="ArticleCategoryId" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="bi bi-eye"></i> View
                </a>
                <button type="reset" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Reset
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}