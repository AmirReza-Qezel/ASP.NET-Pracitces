@using Application.Contract.ArticleAgg.Commands___DTOs
@model IEnumerable<ArticleDTO>
@{
    ViewData["Title"] = "Home Page";
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-newspaper"></i> Articles</h2>
    <a asp-action="Create" asp-controller="Article" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Create New Article
    </a>
</div>

@if (ViewBag.NoArticleFound)
{
    <!-- No articles message -->
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> No articles found.
        <a asp-controller="Article" asp-action="Create">Create your first article</a>
    </div>    
}

@foreach (var article in Model)
{
    <!-- Articles grid -->
    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@article.Title</h5>
                    <p class="card-text text-muted">
                        @{
                            var content = article.Content?.Length < 30 ? article.Content : article.Content.Substring(0, 30);
                        }
                        @content
                    </p>
                    <div class="mb-2">
                        <span class="badge bg-success">Published</span>
                        <span class="badge bg-secondary">@article.Category</span>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-calendar"></i> @article.CreationDate
                    </small>
                </div>
                <div class="card-footer bg-transparent">
                    <div class="btn-group w-100">
                        <a asp-action="Details" asp-controller="Article" asp-route-Id=@article.Id class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-controller="Article" asp-route-Id=@article.Id class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-controller="Article" asp-route-Id=@article.Id class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
