@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="row">
    <div class="col-12 mb-3">
        <div class="row">
            <div class="border-bottom col-3 ml-auto mr-auto text-center">
                <h2>تازه ترین مقالات</h2>
            </div>
        </div>
    </div>
    @foreach (var item in Model.Posts)
    {
        <div class="col-4 mb-2">
            <div class="card">
                <img src="@item.PicturePath" class="card-img-top" alt="@item.AltPicturePath" title="@item.PictureTitle">
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">
                        @item.ShortSummary
                    </p>
                    <a asp-page="/PostDetail" asp-route-id="@item.Id" class="btn btn-primary">ادامه مطلب</a>
                    <a asp-page-handler="Delete" asp-route-id="@item.Id" class="btn btn-primary">حذف</a>
                </div>
            </div>
        </div>
    }

</div>